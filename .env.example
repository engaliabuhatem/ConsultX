# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Core ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,consultx.com,www.consultx.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://consultx.com,https://www.consultx.com
DJANGO_TIME_ZONE=Africa/Cairo

# --- Database (production only — development uses local SQLite) -----------
DATABASE_URL=postgres://consultx:password@localhost:5432/consultx

# --- Email / transactional provider (production only) ----------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@consultx.com
